DATABASE_URL=postgresql://tuxplanner:tuxplanner@localhost:5432/tuxplanner

# ── Auth ──────────────────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens.
# If omitted (or left as the placeholder below), the app auto-generates a
# cryptographically secure key on first startup and persists it to .secret_key
# so sessions survive restarts.  Override with a fixed key in production:
#   openssl rand -hex 32
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY_use_openssl_rand_hex_32

# How long a login session lasts (hours). Default: 8
ACCESS_TOKEN_EXPIRE_HOURS=8

# Set to true when the app is served over HTTPS in production
COOKIE_SECURE=false
