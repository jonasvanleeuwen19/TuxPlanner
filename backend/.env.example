DATABASE_URL=postgresql://tuxplanner:tuxplanner@localhost:5432/tuxplanner

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate a strong secret key with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_BEFORE_DEPLOY_use_openssl_rand_hex_32

# How long a login session lasts (hours). Default: 8
ACCESS_TOKEN_EXPIRE_HOURS=8

# Username for the single app user
AUTH_USERNAME=admin

# Bcrypt hash of the user's password.
# Generate with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt(12)).decode())"
AUTH_PASSWORD_HASH=

# Set to true when the app is served over HTTPS in production
COOKIE_SECURE=false
